{
  "manifest_version": 3,
  "name": "TransMao (譯貓) — 繁體中文抗失效網頁翻譯與反白查詞",
  "short_name": "TransMao",
  "version": "0.1.0",
  "description": "專為繁體中文 (zh-TW) 打造的輕量、抗失效網頁翻譯與反白沉浸式查詞套件：詞性、雙語例句、真人發音，並支援 Hugging Face 本地超小模型。",
  "author": "SxiMao (SixMao0122)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TransMao (譯貓) — 點擊控制網頁翻譯",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
